{
  "name": "openai-api-proxy",
  "version": "1.0.0",
  "description": "A proxy server for OpenAI-compatible APIs with a real-time UI for inspecting requests and responses.",
  "main": "server/index.js",
  "bin": {
    "openai-api-proxy": "./bin/cli.js"
  },
  "scripts": {
    "start": "node bin/cli.js",
    "build:ui": "cd ui && npm install && npm run build",
    "build": "npm run build:ui",
    "dev": "node bin/cli.js"
  },
  "keywords": ["openai", "proxy", "api", "llm"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "body-parser": "^1.20.2",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "node-fetch": "^2.7.0",
    "ws": "^8.16.0"
  }
}
